{
  "manifest_version": 3,
  "name": "Eagle Tab Recorder",
  "version": "0.4.0",
  "description": "錄製目前分頁畫面，存進 Eagle 並附上網址",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabCapture", "offscreen", "downloads", "storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:41595/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "popup.html", "open_in_tab": false },
  "action": {
    "default_title": "Eagle Tab Recorder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "normal-record": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "開始／停止一般錄影"
    },
    "scroll-record": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "MacCtrl+2" },
      "description": "開始／停止捲動錄影（從目前位置等速捲到底部）"
    },
    "region-record": {
      "suggested_key": { "default": "Alt+Shift+A", "mac": "MacCtrl+3" },
      "description": "開始／停止範圍錄影（框選網頁上的特定範圍）"
    }
  }
}
